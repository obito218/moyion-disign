{%- doc -%}
  « Choisissez votre motif » : miniatures des motifs de la même famille.
  Les familles se gèrent dans l'admin (Contenu > Métaobjets > Famille de motifs) :
  un nom et la liste ordonnée des produits. La miniature est le métachamp produit
  « Miniature du motif » (murelle.miniature_motif), sinon la photo principale.
  Chaque miniature est un lien vers la vraie fiche du produit ; le script garde la
  gamme et les dimensions saisies. Rien ne s'affiche si le produit n'est dans
  aucune famille ou si moins de deux motifs de sa famille ont une image.

  @example
  {% content_for 'block', type: 'murelle-motifs', id: 'motifs' %}
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign bs = block.settings
  assign family = nil
  if product != blank
    for f in shop.metaobjects.famille_motifs.values
      for p in f.produits.value
        if p.id == product.id
          assign family = f
          break
        endif
      endfor
      if family
        break
      endif
    endfor
  endif
  assign count = 0
  if family
    for p in family.produits.value
      assign thumb = p.metafields.murelle.miniature_motif.value | default: p.featured_image
      if thumb != blank
        assign count = count | plus: 1
      endif
    endfor
  endif
-%}

{%- if count > 1 -%}
  <murelle-motifs
    class="m-motifs spacing-style"
    style="{% render 'spacing-style', settings: bs %}"
    data-form-id="BuyButtons-ProductForm-{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    <div class="m-motifs__head">
      <p class="m-motifs__legend" id="MotifsLegend-{{ block.id }}">{{ bs.heading | escape }}</p>
      {%- if bs.show_name -%}
        <p class="m-motifs__name" data-motif-name>{{ product.title | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="m-motifs__list" role="list" aria-labelledby="MotifsLegend-{{ block.id }}">
      {%- for p in family.produits.value -%}
        {%- liquid
          assign thumb = p.metafields.murelle.miniature_motif.value | default: p.featured_image
          if thumb == blank
            continue
          endif
          assign src = thumb.preview_image | default: thumb
          assign is_current = false
          if p.id == product.id
            assign is_current = true
          endif
        -%}
        {%- capture options_json -%}{ {%- for v in p.variants -%}{{ v.option1 | json }}:{{ v.id }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }{%- endcapture -%}
        <li class="m-motifs__item">
          <a
            class="m-motif{% if is_current %} is-selected{% endif %}"
            href="{{ p.url }}"
            data-url="{{ p.url }}"
            data-title="{{ p.title | escape }}"
            data-options="{{ options_json | strip | escape }}"
            {% if is_current %}aria-current="page"{% endif %}
          >
            <img
              class="m-motif__img"
              src="{{ src | image_url: width: 160, height: 160, crop: 'center' }}"
              srcset="{{ src | image_url: width: 80, height: 80, crop: 'center' }} 80w, {{ src | image_url: width: 160, height: 160, crop: 'center' }} 160w, {{ src | image_url: width: 240, height: 240, crop: 'center' }} 240w"
              sizes="72px"
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
              alt=""
            >
            <span class="visually-hidden">{{ p.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </murelle-motifs>
  <script src="{{ 'murelle-motifs.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <p class="m-motifs__empty" {{ block.shopify_attributes }}>
    « {{ bs.heading | escape }} » : ce produit n'appartient à aucune famille de motifs ayant au moins deux motifs illustrés (Contenu &gt; Métaobjets &gt; Famille de motifs). Le bloc reste invisible pour les clients.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Choix du motif",
  "settings": [
    { "type": "paragraph", "content": "Les familles se gèrent dans Contenu > Métaobjets > Famille de motifs. La miniature est le métachamp produit « Miniature du motif », sinon la photo principale." },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Choisissez votre motif" },
    { "type": "checkbox", "id": "show_name", "label": "Afficher le nom du motif sélectionné", "default": true },
    { "type": "header", "content": "Espacement" },
    { "type": "range", "id": "padding-block-start", "label": "Marge haute", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Marge basse", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 4 }
  ],
  "presets": [{ "name": "Choix du motif" }]
}
{% endschema %}
